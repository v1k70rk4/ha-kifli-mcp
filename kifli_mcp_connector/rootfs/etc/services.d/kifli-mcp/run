#!/usr/bin/with-contenv bashio
set -euo pipefail

PORT="$(bashio::config 'port')"
EMAIL="$(bashio::config 'email')"
PASS="$(bashio::config 'password')"
COUNTRY="$(bashio::config 'country')"
MCP_URL="$(bashio::config 'mcp_url')"

export NODE_OPTIONS="--dns-result-order=ipv4first"

# mcp-remote auth/cache tartós helyre (HA add-on /data)
export HOME="/data"
export MCP_REMOTE_CONFIG_DIR="/data/.mcp-auth"
mkdir -p "${MCP_REMOTE_CONFIG_DIR}"

if [ -z "${EMAIL}" ] || [ "${EMAIL}" = "null" ]; then
  bashio::log.fatal "email nincs beállítva az add-on konfigurációban (Configuration tab)."
  exit 1
fi

if [ -z "${PASS}" ] || [ "${PASS}" = "null" ]; then
  bashio::log.fatal "password nincs beállítva az add-on konfigurációban (Configuration tab)."
  exit 1
fi

# Visszafelé kompatibilitás: ha nincs ország megadva (régi, 'country' nélküli
# konfiguráció frissítése), az alapértelmezett a magyar.
if [ -z "${COUNTRY}" ] || [ "${COUNTRY}" = "null" ]; then
  COUNTRY="hu"
fi

# Ország → MCP végpont feloldás (az 'mcp_url' override mindent felülír)
if [ -n "${MCP_URL}" ] && [ "${MCP_URL}" != "null" ]; then
  URL="${MCP_URL}"
else
  case "${COUNTRY}" in
    hu) URL="https://mcp.kifli.hu/mcp" ;;
    cz) URL="https://mcp.rohlik.cz/mcp" ;;
    at) URL="https://mcp.gurkerl.at/mcp" ;;
    de) URL="https://mcp.knuspr.de/mcp" ;;
    ro) URL="https://mcp.sezamo.ro/mcp" ;;
    *)
      bashio::log.fatal "Ismeretlen 'country' érték: '${COUNTRY}'. Engedélyezett: hu, cz, at, de, ro (vagy állíts be egyedi 'mcp_url'-t)."
      exit 1
      ;;
  esac
fi

# shim ezekből olvas
export RHL_EMAIL="${EMAIL}"
export RHL_PASS="${PASS}"
export KIFLI_MCP_URL="${URL}"
export KIFLI_TRANSPORT="http-first"

bashio::log.info "Starting Kifli MCP bridge on port ${PORT} (country=${COUNTRY}, url=${URL}, email_len=${#EMAIL}, pass_len=${#PASS}) ..."

exec /opt/venv/bin/mcp-proxy \
  --host=0.0.0.0 \
  --port="${PORT}" \
  --pass-environment \
  --log-level=INFO \
  -- \
  /opt/venv/bin/python3 /app/mcp_schema_shim.py
