#!/usr/bin/with-contenv bashio
set -euo pipefail

PORT="$(bashio::config 'port')"
COUNTRY="$(bashio::config 'country')"
MCP_URL="$(bashio::config 'mcp_url')"

# OAuth tokenek és kliensadatok tartós helye (HA add-on /data)
export KIFLI_DATA_DIR="/data"
export HOME="/data"

# Visszafelé kompatibilitás: ha nincs ország megadva (régi, 'country' nélküli
# konfiguráció frissítése), az alapértelmezett a magyar.
if [ -z "${COUNTRY}" ] || [ "${COUNTRY}" = "null" ]; then
  COUNTRY="hu"
fi

# 2.0: az email/jelszó opciók már nem használatosak (a Rohlik Group megszüntette
# a fejléces bejelentkezést, OAuth kell). Ha még ki vannak töltve, csak szólunk.
if bashio::config.has_value 'email' || bashio::config.has_value 'password'; then
  bashio::log.warning "Az 'email' / 'password' opciók 2.0 óta nem használatosak – a bejelentkezés OAuth-tal, az add-on oldalán történik. Nyugodtan töröld őket a konfigurációból."
fi

# Ország → MCP végpont feloldás (az 'mcp_url' override mindent felülír)
if [ -n "${MCP_URL}" ] && [ "${MCP_URL}" != "null" ]; then
  URL="${MCP_URL}"
else
  case "${COUNTRY}" in
    hu) URL="https://mcp.kifli.hu/mcp" ;;
    cz) URL="https://mcp.rohlik.cz/mcp" ;;
    at) URL="https://mcp.gurkerl.at/mcp" ;;
    de) URL="https://mcp.knuspr.de/mcp" ;;
    ro) URL="https://mcp.sezamo.ro/mcp" ;;
    *)
      bashio::log.fatal "Ismeretlen 'country' érték: '${COUNTRY}'. Engedélyezett: hu, cz, at, de, ro (vagy állíts be egyedi 'mcp_url'-t)."
      exit 1
      ;;
  esac
fi

# a shim ezekből olvas
export KIFLI_MCP_URL="${URL}"
export KIFLI_PORT="${PORT}"
export KIFLI_INGRESS_PORT="42784"
# a felület / értesítések nyelve (hu → magyar eszközleírások)
export KIFLI_LANG="${COUNTRY}"
if bashio::config.true 'new_tools_enabled'; then
  export KIFLI_NEW_TOOLS_ENABLED="true"
else
  export KIFLI_NEW_TOOLS_ENABLED="false"
fi

bashio::log.info "Starting Kifli MCP bridge on port ${PORT} (country=${COUNTRY}, url=${URL}) ..."
bashio::log.info "Bejelentkezés / sign-in: nyisd meg a 'Kifli MCP' oldalt a Home Assistant oldalsávjában (ingress)."

exec /opt/venv/bin/mcp-proxy \
  --host=0.0.0.0 \
  --port="${PORT}" \
  --pass-environment \
  --log-level=INFO \
  -- \
  /opt/venv/bin/python3 /app/mcp_schema_shim.py
